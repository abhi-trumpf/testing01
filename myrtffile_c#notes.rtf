\par     public string ReverseVowels(string s) \{
\par         string vowels = "AEIOUaeiou";
\par         string s2 = "";  // collect vowels
\par 
\par         foreach (char c in s) \{
\par             if (vowels.Contains(c)) \{
\par                 s2 += c;
\par             \}
\par         \}
\par 
\par         char[] result = s.ToCharArray();
\par         int j = s2.Length - 1;  // index for reversed vowels
\par 
\par         for (int i = 0; i < result.Length; i++) \{
\par             if (vowels.Contains(result[i])) \{
\par                 result[i] = s2[j];  // replace vowel with reversed vowel
\par                 j--;
\par             \}
\par         \}
\par 
\par         return new string(result);
\par     \}
\par \}
